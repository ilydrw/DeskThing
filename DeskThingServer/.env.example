# Optional self-hosted services. DeskThing makes no requests to these services
# when the corresponding value is empty.
DESKTHING_STATS_URL=
DESKTHING_FEEDBACK_URL=
DESKTHING_SUPPORTER_TOKEN=

# Optional fixed identity for a compatible statistics service. When omitted,
# DeskThing generates a local signing identity after the user opts in.
DESKTHING_STATS_CLIENT_ID=
DESKTHING_STATS_PRIVATE_KEY=

# Optional release catalogs. Values may be normal GitHub repository URLs or
# GitHub API repository URLs.
DESKTHING_APP_CATALOG_REPOSITORY=
DESKTHING_CLIENT_CATALOG_REPOSITORY=

# Optional firmware service and recommended archive. Users can always upload a
# firmware zip manually when these are empty.
DESKTHING_FIRMWARE_API_URL=
DESKTHING_FIRMWARE_PRODUCT_ID=
DESKTHING_RECOMMENDED_FIRMWARE_VERSION_ID=
DESKTHING_RECOMMENDED_FIRMWARE_FILE_ID=
DESKTHING_RECOMMENDED_FIRMWARE_URL=

# Optional driver installer. Both values are required; DeskThing refuses to
# execute a downloaded installer unless its SHA-256 digest matches.
DESKTHING_DRIVER_INSTALLER_URL=
DESKTHING_DRIVER_INSTALLER_SHA256=

# Optional generic electron-updater feed containing platform metadata such as
# latest.yml and the matching signed release artifacts.
DESKTHING_UPDATE_FEED_URL=

# Proxied artwork and web resources are restricted to public HTTP(S) targets by
# default. Enable only when intentionally using trusted media servers on the
# host's private network.
DESKTHING_PROXY_ALLOW_PRIVATE_NETWORK=false
